# Plantilla de configuración. Copiar a .env y llenar con valores reales.
# NUNCA poner credenciales de verdad en este archivo: va al repositorio.

# ---- Base de datos ----
DATABASE_URL=

# ---- JWT ----
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30

# ---- Endpoint interno para n8n ----
# Autentica /api/eventos/* (cabecera X-Internal-Token). n8n no tiene sesión
# de portal, así que no puede mandar el JWT de portal_users.
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Si queda vacío el endpoint responde 503 y no atiende a nadie. Es a
# propósito: crea leads y confirma qué tenant_id existe, así que no puede
# quedar abierto por olvidar la variable.
N8N_INTERNAL_TOKEN=YycWIyZXI6L-NwwfSeshE5GVjgaSnfs1EFIWi_zGpP7n3b1UpXKlR8HNfR1Vg7S2

# ---- Meta ----
# App ID y App Secret del panel de developers.facebook.com
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v26.0
# Debe coincidir byte por byte con la URI registrada en Meta y con la que
# manda el frontend (NEXT_PUBLIC_META_REDIRECT_URI).
META_REDIRECT_URI=

# ---- WhatsApp (ver services/whatsapp.py) ----
# "kontesta" mientras la app de Meta no tiene Acceso Avanzado aprobado;
# cambiar a "meta" el día que se apruebe (requiere terminar MetaProvider).
WHATSAPP_PROVIDER=kontesta

# ---- Kontesta ----
# API key del panel de Kontesta. Va en la cabecera X-Api-Key de cada
# request server-to-server.
KONTESTA_API_KEY=
KONTESTA_API_BASE_URL=https://api.kontesta.app/v1
# Secreto para validar la firma HMAC-SHA256 de los webhooks entrantes
# (cabecera X-Kontesta-Signature: "t=...,v1=..."). Sin esto,
# verificar_webhook() rechaza todo.
KONTESTA_WEBHOOK_SECRET=

# ---- Google (cuenta de servicio compartida, para Sheets/Docs) ----
# El JSON completo de la cuenta de servicio, en UNA sola línea.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---- Login con Google (opcional, además del alta con correo) ----
# Client ID/secret de un proyecto de Google Cloud (APIs & Services >
# Credentials > OAuth client ID > Web application). El mismo client_id va
# en NEXT_PUBLIC_GOOGLE_CLIENT_ID del frontend.
# Sin GOOGLE_CLIENT_ID, POST /api/auth/google responde 503 y el botón de
# Google del portal no aparece.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- SMTP ----
# Correo del que sale el código de verificación del alta.
# Si SMTP_HOST o SMTP_FROM quedan vacíos, la app arranca igual pero los
# códigos se escriben en el log en vez de enviarse. Sirve para desarrollar;
# en producción hay que llenarlos o nadie recibe su código.
#
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 y una contraseña de
# aplicación (myaccount.google.com/apppasswords) en SMTP_PASSWORD. La
# contraseña normal de la cuenta no funciona.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Remitente. En la mayoría de proveedores tiene que ser el mismo buzón que
# SMTP_USER o un alias verificado; si no, rebota.
SMTP_FROM=
SMTP_FROM_NAME=OperativAI
# false solo si el servidor habla en claro (puerto 25 interno). El 465 usa
# TLS directo y se detecta por el número de puerto, no por este flag.
SMTP_STARTTLS=true

# ---- Verificación de correo ----
CODIGO_VIGENCIA_MINUTOS=10
CODIGO_MAX_INTENTOS=5
CODIGO_REENVIO_SEGUNDOS=60

# ---- CORS ----
# http://localhost:3000  -> flujo `npm run dev` (Next sirve HTTP plano)
# https://localhost:3001 -> flujo `npm run dev:https` (proxy con mkcert)
FRONTEND_ORIGINS=

# ---- Pasarela de cobro activa ----
# "stripe" (por defecto) o "mercadopago". El módulo de Mercado Pago sigue
# completo en el código, pero mientras esto diga "stripe" sus endpoints
# responden 503 y el portal cobra por Stripe. Volver a MP es cambiar esta
# variable: no hay que tocar código ni migrar la base.
PAYMENT_PROVIDER=stripe

# ---- Stripe ----
# Panel de Stripe > Developers > API keys.
# sk_test_... para pruebas, sk_live_... en producción.
# Sin esto, /api/pagos/crear-pago responde 503.
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
# Secreto de firma del webhook (whsec_...). Lo da el panel al crear el
# endpoint, o `stripe listen` en local. NO es la secret key: sirve solo
# para validar el HMAC de Stripe-Signature. Sin esto,
# /api/pagos/stripe/webhook responde 503 y ningún cobro se acredita.
#
# En local:
#   stripe listen --forward-to localhost:8000/api/pagos/stripe/webhook
# En producción, apuntar el endpoint del panel a:
#   {BASE_URL_BACKEND}/api/pagos/stripe/webhook
# y suscribirlo a: checkout.session.completed,
# checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, checkout.session.expired,
# charge.refunded
STRIPE_WEBHOOK_SECRET=
# Moneda de los cobros, en minúsculas (mxn, usd, ars, ...).
STRIPE_CURRENCY=mxn

# ---- Mercado Pago (inhabilitado; ver PAYMENT_PROVIDER) ----
# Credenciales del panel de Mercado Pago (Tus integraciones > Credenciales).
# Con las de prueba, `init_point` apunta al checkout de sandbox.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# "Clave secreta" de la sección Webhooks. NO es el access token: sirve solo
# para validar la firma HMAC de x-signature. Sin esto, /api/pagos/webhook
# responde 503 y ningún cobro se acredita.
MERCADOPAGO_WEBHOOK_SECRET=
# Moneda de los cobros (MXN, ARS, CLP, ...).
MERCADOPAGO_CURRENCY=MXN

# A dónde vuelve el comprador al salir del checkout. Con Stripe son el
# success_url (/pagos/exito) y el cancel_url (/pagos/error); localhost
# funciona sin problema.
#
# OJO (solo Mercado Pago): si esto NO empieza con "https://" (por ejemplo, en local con
# localhost), pagos.py directamente omite `auto_return` al armar la
# preferencia. Mandarlo con back_urls.success apuntando a localhost hace
# que Mercado Pago devuelva 400 ("auto_return invalid. back_url.success
# must be defined") aunque el campo sí esté definido — es la validación de
# auto_return la que exige una URL pública, no la ausencia del campo. Sin
# auto_return la preferencia se crea igual, solo que no hay redirect
# automático al terminar el pago.
BASE_URL_FRONTEND=http://localhost:3000
# URL pública del backend para la notification_url del webhook. En local,
# localhost no sirve: Mercado Pago tiene que poder alcanzarla (ngrok o similar).
BASE_URL_BACKEND=http://localhost:8000
