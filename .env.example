# Plantilla de configuración. Copiar a .env y llenar con valores reales.
# NUNCA poner credenciales de verdad en este archivo: va al repositorio.

# ---- Base de datos ----
DATABASE_URL=

# ---- JWT ----
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30

# ---- Endpoint interno para n8n ----
# Autentica /api/eventos/* (cabecera X-Internal-Token). n8n no tiene sesión
# de portal, así que no puede mandar el JWT de portal_users.
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Si queda vacío el endpoint responde 503 y no atiende a nadie. Es a
# propósito: crea leads y confirma qué tenant_id existe, así que no puede
# quedar abierto por olvidar la variable.
N8N_INTERNAL_TOKEN=

# ---- Compuertas heredadas de n8n (specs 002 y 003) ----
# El nombre es histórico: eran "ya publiqué el cambio en n8n". Con el agente
# en código (AGENTE_EN_CODIGO=true) ese cambio no existe, así que van en true
# y las herramientas/botón quedan disponibles. Con false (o sin la variable,
# que equivale a false) siguen cerrados. Al cambiarlas, reinicia el backend.
#
# historial_citas_cliente y reagendar_reserva: con false existen pero
# desactivadas, y activarlas desde /herramientas da 409.
HISTORIAL_CITAS_N8N_PUBLICADO=true
# "Limpiar el contexto del agente": con false el botón no aparece y el
# endpoint responde 409; los cortes ya registrados siguen vigentes.
CONTEXTO_CONVERSACION_N8N_PUBLICADO=true

# ---- Avisos de citas por WhatsApp (spec 004) ----
# Desde spec 007 cada negocio usa sus propias plantillas, enviadas desde su
# número principal activo (credenciales de su canal en channel_credentials).
# Interruptor maestro de plataforma: false = no se envía ningún aviso. Ya no
# exige AVISOS_CUENTA_GLOBAL_TENANT_ID.
AVISOS_CITA_WHATSAPP_ACTIVOS=false
# Tenant dueño de la línea de la cuenta global (no es un secreto). Solo la respuesta fija lo usa.
AVISOS_CUENTA_GLOBAL_TENANT_ID=
# WABA de Meta de la cuenta global: solo sus eventos de estado de plantilla tocan el estado global.
# Vacía = el handler global no aplica ningún evento a las plantillas globales.
AVISOS_CUENTA_GLOBAL_WABA_ID=
# false = el webhook de NeuroAPI se comporta como hasta ahora. true = quien
# responde a un aviso recibe un texto fijo y su mensaje no llega al agente.
AVISOS_CUENTA_GLOBAL_RESPUESTA_ACTIVA=false
# Frecuencia del job de recordatorios y tiempo sin latido para dar por muerta
# una ejecución (minutos).
AVISOS_CITA_REVISION_MINUTOS=5
AVISOS_EJECUCION_VIVA_MINUTOS=5

# ---- Meta ----
# App ID y App Secret del panel de developers.facebook.com
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v26.0
# Debe coincidir byte por byte con la URI registrada en Meta y con la que
# manda el frontend (NEXT_PUBLIC_META_REDIRECT_URI).
META_REDIRECT_URI=
# Token del handshake de suscripción del webhook (hub.verify_token): el mismo
# que se escribe en el panel de Meta al suscribir el webhook. Sin valor, el
# handshake se rechaza y no se puede (re)suscribir. Se avisa al arrancar si
# AGENTE_EN_CODIGO está encendida y esto falta.
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(32))"
META_VERIFY_TOKEN=

# ---- WhatsApp (ver services/whatsapp.py) ----
# "neuroapi" (BSP, NeuroApiProvider) es el proveedor activo; cambiar a "meta" el día
# que se apruebe Acceso Avanzado (requiere terminar MetaProvider).
WHATSAPP_PROVIDER=neuroapi

# ---- NeuroAPI (NeuroChat) ----
# API key generada en https://neurochat.com.ec/neuroapi/api-keys con el
# scope "whatsapp_cloud_api" activo. Va en la cabecera x-api-key.
NEUROAPI_API_KEY=
# Otra API key, con el scope "instagram_api": vincular Instagram Direct
# (POST /api/canales/instagram/neuroapi/iniciar), enviarle mensajes y
# descargar su media. Vacía = Instagram por NeuroAPI no se puede vincular.
NEUROAPI_INSTA_KEY=
NEUROAPI_API_BASE_URL=https://api.neurochat.com.ec/api/v1
# Secreto para validar la firma HMAC-SHA256 de los webhooks entrantes
# (cabecera X-Hub-Signature-256: "sha256=..."). Sin esto, verificar_webhook()
# rechaza todo.
NEUROAPI_WEBHOOK_SECRET=
# Opcional: phone_number_id de Meta a usar como remitente en cuentas
# multi-número. Vacío = NeuroAPI usa el primer número activo.
NEUROAPI_PHONE_NUMBER_ID=
# Secreto del webhook de NeuroAPI Connect Sessions (alta de WhatsApp Business
# vía Embedded Signup, POST /api/canales/whatsapp/neuroapi/iniciar). Va como
# webhook_secret al crear la sesión y NeuroAPI lo usa para firmar todo lo que
# manda a /api/canales/whatsapp/neuroapi/webhook: la vinculación y, después,
# los mensajes entrantes que el backend reenvía a n8n. Las sesiones de
# Instagram usan el mismo secreto y el mismo webhook.
# Sin esto, ese webhook responde 503: ni vinculaciones ni mensajes.
NEUROAPI_CONNECT_WEBHOOK_SECRET=

# ---- Agente de IA en código (migración desde n8n) ----
# Interruptor del traslado. false (por defecto del código) = /api/canales/entrada
# responde 503 y los mensajes de NeuroAPI no se atienden (NeuroAPI reintenta).
# true = los atiende services/agente/ y n8n deja de recibirlos. Nunca deben
# atender el mismo tráfico a la vez: el cliente recibiría cada respuesta dos
# veces. Con true se exigen ANTHROPIC_API_KEY, META_VERIFY_TOKEN y
# N8N_INTERNAL_TOKEN (pese al nombre, sigue en uso: autentica al proxy interno
# de NeuroAPI, /api/eventos/* y las herramientas de calendario).
AGENTE_EN_CODIGO=true
# Clave de la API de Anthropic. Sin ella el bucle del modelo no arranca (el
# resto del flujo sí: guardar el mensaje, avisar al vendedor, escalar a humano).
ANTHROPIC_API_KEY=
# Tope de tokens de salida por llamada al modelo. Cuenta también el
# razonamiento: un tope ajustado corta la respuesta a media frase.
AGENTE_MAX_TOKENS=8192
# Segundos de espera antes de contestar, para juntar en una sola respuesta los
# mensajes sueltos de una ráfaga.
AGENTE_ANTIFLOOD_SEGUNDOS=5
# Dominios (separados por comas) a los que pueden llamar las herramientas
# http_generico / http_post_json del negocio. Acepta subdominios: con
# "ejemplo.com" pasa "api.ejemplo.com". VACÍO = ninguna llamada externa
# (esas herramientas fallan). Además se rechaza todo host que resuelva a una
# IP privada.
AGENTE_DOMINIOS_PERMITIDOS=
# Acepta dominio_permitido='*' en el widget (cualquier sitio). Solo para
# desarrollo: en producción déjalo en false y que cada negocio registre su
# dominio real.
WIDGET_COMODIN_PERMITIDO=false

# ---- Google (cuenta de servicio compartida, para Sheets/Docs) ----
# El JSON completo de la cuenta de servicio, en UNA sola línea.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---- Login con Google (opcional, además del alta con correo) ----
# Client ID/secret de un proyecto de Google Cloud (APIs & Services >
# Credentials > OAuth client ID > Web application). El mismo client_id va
# en NEXT_PUBLIC_GOOGLE_CLIENT_ID del frontend.
# Sin GOOGLE_CLIENT_ID, POST /api/auth/google responde 503 y el botón de
# Google del portal no aparece.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- SMTP ----
# Correo del que sale el código de verificación del alta.
# Si SMTP_HOST o SMTP_FROM quedan vacíos, la app arranca igual pero los
# códigos se escriben en el log en vez de enviarse. Sirve para desarrollar;
# en producción hay que llenarlos o nadie recibe su código.
#
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 y una contraseña de
# aplicación (myaccount.google.com/apppasswords) en SMTP_PASSWORD. La
# contraseña normal de la cuenta no funciona.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Remitente. En la mayoría de proveedores tiene que ser el mismo buzón que
# SMTP_USER o un alias verificado; si no, rebota.
SMTP_FROM=
SMTP_FROM_NAME=OperativAI
# false solo si el servidor habla en claro (puerto 25 interno). El 465 usa
# TLS directo y se detecta por el número de puerto, no por este flag.
SMTP_STARTTLS=true

# ---- Verificación de correo ----
CODIGO_VIGENCIA_MINUTOS=10
CODIGO_MAX_INTENTOS=5
CODIGO_REENVIO_SEGUNDOS=60

# ---- CORS ----
# http://localhost:3000  -> flujo `npm run dev` (Next sirve HTTP plano)
# https://localhost:3001 -> flujo `npm run dev:https` (proxy con mkcert)
FRONTEND_ORIGINS=

# ---- Pasarela de cobro activa ----
# "stripe" (por defecto) o "mercadopago". El módulo de Mercado Pago sigue
# completo en el código, pero mientras esto diga "stripe" sus endpoints
# responden 503 y el portal cobra por Stripe. Volver a MP es cambiar esta
# variable: no hay que tocar código ni migrar la base.
PAYMENT_PROVIDER=stripe

# ---- Stripe ----
# Panel de Stripe > Developers > API keys.
# sk_test_... para pruebas, sk_live_... en producción.
# Sin esto, /api/pagos/crear-pago responde 503.
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
# Secreto de firma del webhook (whsec_...). Lo da el panel al crear el
# endpoint, o `stripe listen` en local. NO es la secret key: sirve solo
# para validar el HMAC de Stripe-Signature. Sin esto,
# /api/pagos/stripe/webhook responde 503 y ningún cobro se acredita.
#
# En local:
#   stripe listen --forward-to localhost:8000/api/pagos/stripe/webhook
# En producción, apuntar el endpoint del panel a:
#   {BASE_URL_BACKEND}/api/pagos/stripe/webhook
# y suscribirlo a: checkout.session.completed,
# checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, checkout.session.expired,
# charge.refunded, invoice.payment_succeeded, invoice.payment_failed,
# customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=
# Moneda de los cobros, en minúsculas (mxn, usd, ars, ...).
STRIPE_CURRENCY=mxn
# Los Price IDs recurrentes de cada plan NO van acá: se cargan en
# /gerencia/planes (columna planes.stripe_price_id). Ver README, "Suscripción
# recurrente con Stripe".

# ---- Stripe Connect ----
# Cobros que cada tenant hace a SUS PROPIOS clientes (no a OperativAI):
# cada owner conecta su cuenta de Stripe (Express, onboarding hospedado) y
# genera links de pago desde /cobros o directo desde el agente de IA.
# Usa la misma STRIPE_SECRET_KEY de arriba.
#
# Apagador maestro: en false, /api/pagos/connect/* responde 503 y la tool
# del agente no se ofrece en ningún negocio.
STRIPE_CONNECT_ACTIVO=false
# Si la plataforma se queda con una comisión (application_fee_amount) sobre
# cada cobro. En false, el 100% del cobro es para el tenant (menos las
# comisiones de procesamiento propias de Stripe, que paga siempre la cuenta
# conectada en un cargo directo).
STRIPE_CONNECT_APPLICATION_FEE_ACTIVO=false
# Porcentaje que se queda la plataforma cuando el toggle de arriba está
# activo (admite decimales, ej. 2.5). Solo se lee si
# STRIPE_CONNECT_APPLICATION_FEE_ACTIVO=true.
STRIPE_CONNECT_APPLICATION_FEE_PERCENT=0
#
# El webhook de Connect es OTRO endpoint en el panel de Stripe, no una
# casilla sobre el de arriba (el scope "Connected accounts" se fija al
# crear el endpoint y no se le puede agregar después a uno existente):
#   Panel > Developers > Webhooks > Add destination
#   URL: la misma de STRIPE_WEBHOOK_SECRET -> {BASE_URL_BACKEND}/api/pagos/stripe/webhook
#   Events from: Connected accounts
#   Eventos: account.updated, checkout.session.completed
# Ese endpoint nuevo da SU PROPIO secreto (whsec_...) -- va acá, no arriba.
STRIPE_CONNECT_WEBHOOK_SECRET=

# ---- Mercado Pago (inhabilitado; ver PAYMENT_PROVIDER) ----
# Credenciales del panel de Mercado Pago (Tus integraciones > Credenciales).
# Con las de prueba, `init_point` apunta al checkout de sandbox.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# "Clave secreta" de la sección Webhooks. NO es el access token: sirve solo
# para validar la firma HMAC de x-signature. Sin esto, /api/pagos/webhook
# responde 503 y ningún cobro se acredita.
MERCADOPAGO_WEBHOOK_SECRET=
# Moneda de los cobros (MXN, ARS, CLP, ...).
MERCADOPAGO_CURRENCY=MXN

# A dónde vuelve el comprador al salir del checkout. Con Stripe son el
# success_url (/pagos/exito) y el cancel_url (/pagos/error); localhost
# funciona sin problema.
#
# OJO (solo Mercado Pago): si esto NO empieza con "https://" (por ejemplo, en local con
# localhost), pagos.py directamente omite `auto_return` al armar la
# preferencia. Mandarlo con back_urls.success apuntando a localhost hace
# que Mercado Pago devuelva 400 ("auto_return invalid. back_url.success
# must be defined") aunque el campo sí esté definido — es la validación de
# auto_return la que exige una URL pública, no la ausencia del campo. Sin
# auto_return la preferencia se crea igual, solo que no hay redirect
# automático al terminar el pago.
BASE_URL_FRONTEND=http://localhost:3000
# URL pública del backend para la notification_url del webhook. En local,
# localhost no sirve: Mercado Pago tiene que poder alcanzarla (ngrok o similar).
BASE_URL_BACKEND=http://localhost:8000

# ---- Panel de plataforma (nivel gerencia) ----
# Tipo de cambio automático (recomendado si cobras en MXN): token gratuito
# del SIE API de Banxico, se pide en
# https://www.banxico.org.mx/SieAPIRest/service/v1/token. Con esto, el
# margen usa el FIX oficial del día en vez de un valor fijo. Solo aplica si
# la moneda de cobro es MXN (ver services/banxico.py).
BANXICO_TOKEN=
# Respaldo manual: unidades de la moneda de cobro por dólar (ej. 18.5 para
# MXN). Se usa si BANXICO_TOKEN no está configurado, o si Banxico falla y
# nunca hubo un valor en caché. Sin ninguno de los dos, el panel no calcula
# margen: el costo de modelos está en USD. Si cobras en USD, déjalo vacío.
TIPO_CAMBIO_USD=
# Consumo anómalo: 24 h >= FACTOR x promedio diario previo (con PISO mínimo).
CONSUMO_ANOMALO_FACTOR=5
CONSUMO_ANOMALO_PISO_TOKENS=20000
CONSUMO_ANOMALO_INTERVALO_HORAS=1
# Vida del token de "ver como el negocio" (sin refresh).
IMPERSONACION_MINUTOS=30
# "Ver como" con escritura: minutos que tiene el dueño para responder la
# solicitud, y cargos de gerencia_users que pueden pedirla (sin mayúsculas).
ACCESO_SOPORTE_VIGENCIA_MINUTOS=30
ACCESO_SOPORTE_CARGOS=gerencia,developer,ti

# ---- Términos y condiciones ----
# Fecha de "Última actualización" de /condiciones y /privacidad; se guarda
# junto a la aceptación de cada usuario.
TERMINOS_VERSION=2026-09-23

# ---- Perfil del usuario ----
# Foto: peso máximo (bytes) y lado máximo (px).
PERFIL_FOTO_MAX_BYTES=2097152
PERFIL_FOTO_MAX_PX=642
# Recordatorios de perfil incompleto: uno cada 24 h durante estos días desde
# el alta; el job corre cada INTERVALO_HORAS.
PERFIL_RECORDATORIO_DIAS=20
PERFIL_RECORDATORIO_INTERVALO_HORAS=1

# ---- Adjuntos de WhatsApp (bytes) ----
WA_IMAGEN_MAX_BYTES=5242880
WA_DOCUMENTO_MAX_BYTES=16777216

# ---- Reportes de incidencias ----
# Máximo por usuario y hora, peso (bytes) y lado (px) de la captura adjunta.
REPORTES_MAX_POR_HORA=3
REPORTE_ADJUNTO_MAX_BYTES=5242880
REPORTE_ADJUNTO_MAX_PX=8192

# ---- Jobs en segundo plano ----
# Citas 'confirmada' ya vencidas pasan a 'no_asistio' (cada N min, con gracia).
RESERVAS_VENCIDAS_INTERVALO_MINUTOS=15
RESERVAS_VENCIDAS_GRACIA_MINUTOS=0
# Tareas de seguimiento 'pendiente' con fecha pasada pasan a 'vencida'.
TAREAS_VENCIDAS_INTERVALO_MINUTOS=15
# Varios números de WhatsApp: cada cuántos minutos se reevalúa el cupo, y
# hora UTC (0-23) de la retención de 12 meses de conversaciones ocultas.
NUMEROS_REEVALUACION_INTERVALO_MINUTOS=1
NUMEROS_RETENCION_HORA_UTC=3
# Leads sin actividad: días para contarlos y cada cuántas horas se revisa.
ALERTA_SIN_ACTIVIDAD_DIAS=7
ALERTA_SIN_ACTIVIDAD_INTERVALO_HORAS=1
# Hora UTC (0-23) del resumen diario de alertas sin leer por correo.
RESUMEN_ALERTAS_HORA_UTC=21
# Cada cuántas horas se pausan las suscripciones vencidas.
SUSCRIPCION_REVISION_INTERVALO_HORAS=1

# ---- Push a la app móvil (Expo) ----
# Solo si el proyecto de EAS tiene "Enhanced Security for Push Notifications".
EXPO_ACCESS_TOKEN=
# false apaga los push sin tocar código (pruebas, local sin red).
PUSH_ACTIVO=true

COOKIE_SAMESITE=
COOKIE_SECURE=
# ---- Vista de gerencia a las conversaciones de un número ----
# phone_number_id de Meta (agentes_canal.phone_number_id) cuyas conversaciones abre
# /gerencia/conversaciones a todo gerencia_users. Vacío = función apagada. El dueño del
# negocio puede revocarla desde su portal (sql/67).
GERENCIA_NUMERO_PHONE_NUMBER_ID=
